{
  "name": "mysuru-open-world",
  "version": "0.0.0",
  "private": true,
  "description": "A small but polished 3D open-world game inspired by Mysuru, Karnataka, running in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:static && npm run test:e2e",
    "format": "prettier --write .",
    "check:static": "node tests/static/run-all.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.185.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
